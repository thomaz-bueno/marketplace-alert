# Server
SERVER_PORT=3000

# PostgreSQL (used by docker-compose and by the server)
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace
POSTGRES_DB=marketplace_alert
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace_alert

# Redis (used by docker-compose and by the server)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Web
WEB_PORT=5173

# Browser (Playwright) — headless=false keeps the window open for manual Facebook login
BROWSER_HEADLESS=false
# BROWSER_USER_DATA_DIR=.browser-profile

# Scheduler — cron expression for the scraping cycle (default: every 15 minutes)
# CRON_SCHEDULE=*/15 * * * *
