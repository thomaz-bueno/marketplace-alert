{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:check": "tsx src/scripts/check-alerts.ts",
    "redis:check": "tsx src/scripts/check-products.ts",
    "scrape:check": "tsx src/scripts/check-scraper.ts",
    "telegram:check": "tsx src/scripts/check-telegram.ts",
    "retry:check": "tsx src/scripts/check-telegram-retry.ts",
    "cycle:check": "tsx src/scripts/check-cycle-notify.ts",
    "browser:check": "tsx src/scripts/check-browser.ts",
    "browser:login": "tsx src/scripts/login-facebook.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "playwright": "^1.61.1",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
